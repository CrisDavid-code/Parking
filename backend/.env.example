# Copia a backend/.env y completa. NUNCA subas .env al repositorio.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veyro?schema=public

# Auth — en producción JWT_SECRET es obligatorio y >= 32 caracteres (openssl rand -base64 48)
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Orígenes permitidos (coma). Debe incluir la URL del frontend.
CORS_ORIGINS=http://localhost:8080
APP_URL=http://localhost:8080

# Retención de datos de ubicación
LOCATION_RETENTION_DAYS=90
POSITION_ESTIMATE_RETENTION_DAYS=30
RETENTION_JOB_ENABLED=false

# Pagos — vacíos = cambios de plan de pago devuelven 503 payments_not_configured
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=

# Almacenamiento privado S3/compatible — vacíos = subida de fotos devuelve 503 storage_not_configured
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Correo (no implementado aún: el envío responde delivered:false)
SMTP_URL=

RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info
# Swagger siempre activo fuera de producción; en producción solo si true
SWAGGER_ENABLED=false

# Seed (solo desarrollo/staging)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TEST_BUILDING=false
